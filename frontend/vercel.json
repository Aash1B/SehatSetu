{
  "framework": "vite",
  "installCommand": "npm install --workspaces=false",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!assets/|favicon\\.svg|icons\\.svg|manifest\\.webmanifest|sw\\.js|registerSW\\.js|workbox-.*\\.js|offline\\.html|pwa-.*\\.png|maskable-.*\\.png|apple-touch-icon\\.png|favicon\\.ico).*)", "destination": "/index.html" }
  ]
}
