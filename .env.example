GOOGLE_MAPS_API_KEY=replace-with-your-google-maps-api-key
ENCRYPTION_KEY=replace-with-a-64-character-hex-string
ACCOUNT_DELETION_OTP_EXPIRY_MINUTES=10
ACCOUNT_DELETION_OTP_RESEND_SECONDS=60