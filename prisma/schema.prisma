generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String               @id @default(uuid())
  email                  String               @unique
  passwordHash           String
  fullName               String
  role                   Role
  authProvider           AuthProvider         @default(LOCAL)
  googleId               String?              @unique
  phone                  String?              @unique
  phoneVerified          Boolean              @default(false)
  phoneOtpHash           String?
  phoneOtpExpiresAt      DateTime?
  avatarUrl              String?
  createdAt              DateTime             @default(now())
  dataConsentAt          DateTime?
  dataConsentGiven       Boolean              @default(false)
  emailVerified          Boolean              @default(false)
  emailOtpHash           String?
  emailOtpExpiresAt      DateTime?
  resetTokenHash         String?
  resetTokenExpiresAt    DateTime?
  accountStatus          String               @default("ACTIVE")
  tokenVersion           Int                  @default(0)
  deletedAt              DateTime?
  accountDeletionOtps    AccountDeletionOtp[]
  doctor                 Doctor?
  uploadedMedicalReports MedicalReport[]      @relation("MedicalReportUploader")
  patient                Patient?
}

model AccountDeletionOtp {
  id         String    @id @default(uuid())
  userId     String
  otpHash    String
  purpose    String    @default("ACCOUNT_DELETION")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model AccountDeletionAudit {
  id             String   @id @default(uuid())
  userIdentifier String
  role           Role
  outcome        String
  createdAt      DateTime @default(now())

  @@index([userIdentifier, createdAt])
}

model StorageCleanupJob {
  id          String    @id @default(uuid())
  bucket      String
  path        String
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([bucket, path])
  @@index([status, createdAt])
}

model Patient {
  id                String          @id @default(uuid())
  userId            String          @unique
  gender            String?
  dateOfBirth       DateTime?
  allergies         String[]
  chronicConditions String[]
  age               String?
  bloodGroup        String?
  emergencyContact  String?
  height            String?
  phone             String?
  weight            String?
  profileImagePath  String?
  abhaId            String?         @unique
  appointments      Appointment[]
  ehrRecords        EhrRecord[]
  medicalReports    MedicalReport[]
  user              User            @relation(fields: [userId], references: [id])
  payments          Payment[]
  prescriptions     Prescription[]
  pregnancies       Pregnancy[]
  children          Child[]
  mchDocuments      MchDocument[]
  mchReminders      MchReminder[]
}

// ─── MCH: Pregnancy ────────────────────────────────────────────────────────

model Pregnancy {
  id                  String               @id @default(uuid())
  patientId           String
  status              PregnancyStatus      @default(ACTIVE)
  lmpDate             DateTime?
  eddLmp              DateTime?
  eddUltrasound       DateTime?
  gestationalWeeksAtBooking Int?
  gravida             Int?
  para                Int?
  abortions           Int?
  bloodGroup          String?
  rhFactor            String?
  highRiskFactors     String[]
  notes               String?
  deliveryDate        DateTime?
  deliveryType        String?
  deliveryOutcome     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  patient             Patient              @relation(fields: [patientId], references: [id])
  ancVisits           AncVisit[]
  investigations      PregnancyInvestigation[]
  safetyFlags         MchSafetyFlag[]      @relation("PregnancySafetyFlags")
  mchDocuments        MchDocument[]        @relation("PregnancyDocuments")

  @@index([patientId, status])
  @@index([patientId, createdAt])
}

// ─── MCH: ANC Visit ────────────────────────────────────────────────────────

model AncVisit {
  id                  String           @id @default(uuid())
  pregnancyId         String
  visitDate           DateTime
  gestationalWeek     Int?
  weight              Float?
  systolicBp          Int?
  diastolicBp         Int?
  pulseRate           Int?
  hemoglobin          Float?
  fetalHeartRate      Int?
  fundalHeight        Float?
  urineProtein        String?
  urineGlucose        String?
  bloodSugarFasting   Float?
  bloodSugarPp        Float?
  complaints          String?
  clinicalFindings    String?
  advice              String?
  nextVisitDate       DateTime?
  // Patient-entered vs doctor-verified fields
  enteredByPatient    Boolean          @default(true)
  verifiedByDoctorId  String?
  verifiedAt          DateTime?
  verificationNotes   String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  pregnancy           Pregnancy        @relation(fields: [pregnancyId], references: [id])
  safetyFlags         MchSafetyFlag[]  @relation("AncSafetyFlags")

  @@index([pregnancyId, visitDate])
}

// ─── MCH: Pregnancy Investigation ─────────────────────────────────────────

model PregnancyInvestigation {
  id                String                      @id @default(uuid())
  pregnancyId       String
  testName          String
  testDate          DateTime?
  result            String?
  unit              String?
  referenceRange    String?
  notes             String?
  reportId          String?
  status            InvestigationStatus         @default(ORDERED)
  enteredByPatient  Boolean                     @default(true)
  verifiedByDoctorId String?
  verifiedAt        DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  pregnancy         Pregnancy                   @relation(fields: [pregnancyId], references: [id])

  @@index([pregnancyId, testDate])
}

// ─── MCH: Child ────────────────────────────────────────────────────────────

model Child {
  id                String                @id @default(uuid())
  patientId         String
  name              String
  dateOfBirth       DateTime
  sex               ChildSex
  bloodGroup        String?
  birthWeight       Float?
  birthLength       Float?
  birthHeadCirc     Float?
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  patient           Patient               @relation(fields: [patientId], references: [id])
  vaccinationRecords VaccinationRecord[]
  growthMeasurements GrowthMeasurement[]
  milestones        DevelopmentalMilestone[]
  safetyFlags       MchSafetyFlag[]       @relation("ChildSafetyFlags")
  mchDocuments      MchDocument[]         @relation("ChildDocuments")
  mchReminders      MchReminder[]         @relation("ChildReminders")

  @@index([patientId])
}

// ─── MCH: Vaccination Record ───────────────────────────────────────────────

model VaccinationRecord {
  id                  String              @id @default(uuid())
  childId             String
  vaccineName         String
  doseNumber          Int                 @default(1)
  scheduledDate       DateTime
  administeredDate    DateTime?
  status              VaccinationStatus   @default(UPCOMING)
  administeredAt      String?
  batchNumber         String?
  notes               String?
  verifiedByDoctorId  String?
  verifiedAt          DateTime?
  reminderSentAt      Json?               // { "7d": ISO, "3d": ISO, "due": ISO, "overdue": ISO }
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  child               Child               @relation(fields: [childId], references: [id])

  @@index([childId, scheduledDate])
  @@index([status, scheduledDate])
}

// ─── MCH: Growth Measurement ───────────────────────────────────────────────

model GrowthMeasurement {
  id                  String          @id @default(uuid())
  childId             String
  measurementDate     DateTime
  ageMonths           Float?
  weightKg            Float?
  heightCm            Float?
  headCircCm          Float?
  temperature         Float?
  pulseRate           Int?
  spo2                Float?
  bmi                 Float?
  notes               String?
  enteredByPatient    Boolean         @default(true)
  verifiedByDoctorId  String?
  verifiedAt          DateTime?
  safetyFlags         MchSafetyFlag[] @relation("GrowthSafetyFlags")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  child               Child           @relation(fields: [childId], references: [id])

  @@index([childId, measurementDate])
}

// ─── MCH: Developmental Milestone ─────────────────────────────────────────

model DevelopmentalMilestone {
  id                  String            @id @default(uuid())
  childId             String
  category            MilestoneCategory
  milestoneName       String
  expectedAgeMonths   Int
  expectedAgeMaxMonths Int?
  status              MilestoneStatus   @default(PENDING)
  achievedDate        DateTime?
  parentObservation   String?
  doctorAssessment    String?
  verifiedByDoctorId  String?
  verifiedAt          DateTime?
  needsReview         Boolean           @default(false)
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  child               Child             @relation(fields: [childId], references: [id])

  @@index([childId, category])
  @@index([childId, status])
}

// ─── MCH: Safety Flag ─────────────────────────────────────────────────────

model MchSafetyFlag {
  id                  String          @id @default(uuid())
  pregnancyId         String?
  ancVisitId          String?
  childId             String?
  growthMeasurementId String?
  flagCode            String
  severity            FlagSeverity
  message             String
  ruleDescription     String
  status              FlagStatus      @default(OPEN)
  reviewedByDoctorId  String?
  reviewedAt          DateTime?
  reviewNotes         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  pregnancy           Pregnancy?      @relation("PregnancySafetyFlags", fields: [pregnancyId], references: [id])
  ancVisit            AncVisit?       @relation("AncSafetyFlags", fields: [ancVisitId], references: [id])
  child               Child?          @relation("ChildSafetyFlags", fields: [childId], references: [id])
  growthMeasurement   GrowthMeasurement? @relation("GrowthSafetyFlags", fields: [growthMeasurementId], references: [id])

  @@index([pregnancyId, status])
  @@index([ancVisitId])
  @@index([childId, status])
  @@index([growthMeasurementId])
}

// ─── MCH: Document ─────────────────────────────────────────────────────────

model MchDocument {
  id                String          @id @default(uuid())
  patientId         String
  pregnancyId       String?
  childId           String?
  investigationId   String?
  medicalReportId   String?
  title             String
  category          String
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  patient           Patient         @relation(fields: [patientId], references: [id])
  pregnancy         Pregnancy?      @relation("PregnancyDocuments", fields: [pregnancyId], references: [id])
  child             Child?          @relation("ChildDocuments", fields: [childId], references: [id])

  @@index([patientId])
  @@index([pregnancyId])
  @@index([childId])
}

// ─── MCH: Reminder ─────────────────────────────────────────────────────────

model MchReminder {
  id                  String          @id @default(uuid())
  patientId           String
  childId             String?
  vaccinationRecordId String?
  ancVisitId          String?
  reminderType        MchReminderType
  eventDate           DateTime
  status              ReminderStatus  @default(PENDING)
  sentAt              DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  patient             Patient         @relation(fields: [patientId], references: [id])
  child               Child?          @relation("ChildReminders", fields: [childId], references: [id])

  @@unique([vaccinationRecordId, reminderType])
  @@unique([ancVisitId, reminderType])
  @@index([patientId, status])
  @@index([eventDate, status])
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Doctor {
  id                  String             @id @default(uuid())
  userId              String?            @unique
  name                String?
  gender              Gender?
  specialty           String
  consultationFee     Int?               @default(500)
  availableToday      Boolean?           @default(true)
  degrees             String?
  experience          String?
  fee                 String?
  hospital            String?
  imageUrl            String?
  imageStoragePath    String?
  imagePosition       String?            @default("50% 20%")
  location            String?
  priorityLevel       String?            @default("P1")
  priorityScore       Int?               @default(90)
  rating              Float?             @default(4.8)
  reviewsCount        Int?               @default(0)
  tags                String[]
  availability        Json?
  profileCompleted    Boolean            @default(false)
  isVerified          Boolean            @default(false)
  isActive            Boolean            @default(true)
  verificationStatus  VerificationStatus @default(PENDING)
  approvalToken       String?            @unique
  approvalTokenExpiry DateTime?
  rejectionReason     String?
  appointments        Appointment[]
  user                User?              @relation(fields: [userId], references: [id])
  prescriptions       Prescription[]
  availabilities      DoctorAvailability[]
  slots               Slot[]
}

enum SlotStatus {
  AVAILABLE
  RESERVED
  BOOKED
  BLOCKED
}

model DoctorAvailability {
  id          String   @id @default(uuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startTime   String
  endTime     String
  slotMinutes Int      @default(15)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@unique([doctorId, dayOfWeek])
}

model Slot {
  id            String       @id @default(uuid())
  doctorId      String
  doctor        Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date          String
  startTime     String
  endTime       String
  status        SlotStatus   @default(AVAILABLE)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  createdAt     DateTime     @default(now())

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date, status])
}

model Appointment {
  id                    String          @id @default(uuid())
  patientId             String?
  doctorId              String
  scheduledAt           DateTime?
  status                String          @default("WAITING")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt

  patientName           String?
  patientAge            String?
  patientGender         String?
  patientHeight         String?
  patientWeight         String?
  patientBloodGroup     String?
  patientPhone          String?
  patientEmail          String?

  healthConcern         String?
  symptoms              String[]
  duration              String?
  severity              String?
  consultMode           String?
  urgency               String?
  notes                 String?

  date                  String?
  timeSlot              String?
  priority              String          @default("ROUTINE")
  isFollowUp            Boolean         @default(false)
  emailRemindersEnabled Boolean         @default(true)

  doctor                Doctor          @relation(fields: [doctorId], references: [id])
  patient               Patient?        @relation(fields: [patientId], references: [id])
  slot                  Slot?
  ehrRecord             EhrRecord?
  medicalReports        MedicalReport[]
  payment               Payment?
  prescription          Prescription?

  @@index([doctorId, date, timeSlot])
}

model MedicalReport {
  id                     String                 @id @default(uuid())
  patientId              String
  uploadedByUserId       String
  appointmentId          String?
  originalFileName       String
  storageBucket          String
  storagePath            String                 @unique
  mimeType               String
  fileSizeBytes          BigInt
  reportType             MedicalReportType
  status                 MedicalReportStatus    @default(PENDING_UPLOAD)
  ocrStatus              MedicalReportOcrStatus @default(NOT_STARTED)
  extractedText          String?
  extractedData          Json?
  processingErrorCode    String?
  processingErrorMessage String?
  createdAt              DateTime               @default(now())
  uploadedAt             DateTime?
  processingStartedAt    DateTime?
  processedAt            DateTime?
  updatedAt              DateTime               @updatedAt
  appointment            Appointment?           @relation(fields: [appointmentId], references: [id])
  patient                Patient                @relation(fields: [patientId], references: [id])
  uploadedBy             User                   @relation("MedicalReportUploader", fields: [uploadedByUserId], references: [id])

  @@index([patientId, createdAt])
  @@index([appointmentId])
  @@index([uploadedByUserId])
  @@index([status])
}

model EhrRecord {
  id            String       @id @default(uuid())
  patientId     String
  appointmentId String?      @unique
  diagnosis     String?
  notes         String?
  aiSummary     String?
  createdAt     DateTime     @default(now())
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patient       Patient      @relation(fields: [patientId], references: [id])
}

model Prescription {
  id            String      @id @default(uuid())
  patientId     String
  doctorId      String
  appointmentId String      @unique
  medicines     Json
  dietAdvice    String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  patient       Patient     @relation(fields: [patientId], references: [id])
}

model Payment {
  id              String      @id @default(uuid())
  patientId       String
  appointmentId   String      @unique
  razorpayOrderId String?
  amount          Int
  status          String      @default("PENDING")
  refundId        String?
  errorMessage    String?
  createdAt       DateTime    @default(now())
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  patient         Patient     @relation(fields: [patientId], references: [id])
}

model Hospital {
  id        String @id @default(uuid())
  name      String
  type      String
  latitude  Float
  longitude Float
}

model SagaState {
  id                String    @id @default(uuid())
  sagaId            String    @unique
  type              String
  status            String
  step              Int       @default(0)
  appointmentId     String?
  paymentId         String?
  idempotencyKey    String?   @unique
  retries           Int       @default(0)
  errorMessage      String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Role {
  PATIENT
  DOCTOR
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  WAITING
}

enum MedicalReportStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  PROCESSED
  OCR_FAILED
  DELETED
}

enum MedicalReportOcrStatus {
  NOT_STARTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum MedicalReportType {
  LAB_REPORT
  PRESCRIPTION
  DISCHARGE_SUMMARY
  SCAN
  OTHER
}

// ─── MCH Enums ────────────────────────────────────────────────────────────

enum PregnancyStatus {
  ACTIVE
  COMPLETED
  LOST
  TERMINATED
}

enum InvestigationStatus {
  ORDERED
  SAMPLE_COLLECTED
  RESULT_AVAILABLE
  VERIFIED
}

enum ChildSex {
  MALE
  FEMALE
  OTHER
}

enum VaccinationStatus {
  UPCOMING
  DUE
  COMPLETED
  MISSED
}

enum MilestoneCategory {
  GROSS_MOTOR
  FINE_MOTOR
  LANGUAGE
  SOCIAL_EMOTIONAL
  COGNITIVE
}

enum MilestoneStatus {
  PENDING
  ACHIEVED
  NEEDS_REVIEW
}

enum FlagSeverity {
  INFO
  WARNING
  CRITICAL
}

enum FlagStatus {
  OPEN
  REVIEWED
  RESOLVED
}

enum MchReminderType {
  VACCINATION_7D
  VACCINATION_3D
  VACCINATION_DUE
  VACCINATION_OVERDUE
  ANC_7D
  ANC_3D
  ANC_DUE
  ANC_OVERDUE
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}
