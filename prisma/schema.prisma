generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  fullName         String
  role             Role
  createdAt        DateTime @default(now())
  dataConsentGiven Boolean  @default(false)
  dataConsentAt    DateTime?
  patient Patient?
  doctor  Doctor?
}

enum Role {
  PATIENT
  DOCTOR
}

enum AppointmentStatus {
  SCHEDULED
  WAITING
  COMPLETED
  CANCELLED
}

model Patient {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  phone             String?
  phoneNumber       String?
  gender            String?
  age               String?
  dateOfBirth       DateTime?
  height            String?
  weight            String?
  bloodGroup        String?
  emergencyContact  String?
  address           String?
  profilePhoto      String?
  allergies         String[]
  chronicConditions String[]

  appointments  Appointment[]
  ehrRecords    EhrRecord[]
  prescriptions Prescription[]
  payments      Payment[]
}

model Doctor {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  name            String   @default("Dr. Doctor")
  specialty       String   @default("General Physician")
  experience      String?  @default("10+ Years Experience")
  rating          Float    @default(4.8)
  reviewsCount    Int      @default(0)
  hospital        String?  @default("Apollo Medical Center")
  location        String?  @default("Delhi")
  imageUrl        String?
  fee             String?  @default("₹500")
  consultationFee Int?     @default(500)
  availableToday  Boolean  @default(true)
  priorityLevel   String   @default("P1")
  priorityScore   Int      @default(90)
  degrees         String?  @default("MBBS")
  tags            String[]

  appointments  Appointment[]
  prescriptions Prescription[]
}

model Appointment {
  id                String   @id @default(uuid())
  
  // Relational fields (Incoming branch)
  patientId         String?
  patient           Patient? @relation(fields: [patientId], references: [id])
  doctorId          String
  doctor            Doctor?  @relation(fields: [doctorId], references: [id])
  scheduledAt       DateTime?
  status            String   @default("WAITING") 
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt @default(now())

  // Flat fields from booking flow (HEAD)
  patientName       String?
  patientAge        String?
  patientGender     String?
  patientHeight     String?
  patientWeight     String?
  patientBloodGroup String?
  patientPhone      String?
  patientEmail      String?
  
  healthConcern     String?
  symptoms          String[]
  duration          String?
  severity          String?
  consultMode       String?
  urgency           String?
  notes             String?
  
  date              String?
  timeSlot          String?
  priority          String   @default("ROUTINE")
  
  ehrRecord    EhrRecord?
  prescription Prescription?
  payment      Payment?
}

model EhrRecord {
  id            String       @id @default(uuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  diagnosis     String?
  notes         String?
  aiSummary     String?
  createdAt     DateTime     @default(now())
}

model Prescription {
  id            String      @id @default(uuid())
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  medicines     Json
  dietAdvice    String?
  createdAt     DateTime    @default(now())
}

model Payment {
  id              String   @id @default(uuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  appointmentId   String   @unique
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  razorpayOrderId String?
  amount          Int
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

model Hospital {
  id        String @id @default(uuid())
  name      String
  type      String
  latitude  Float
  longitude Float
}