generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String          @id @default(uuid())
  email                  String          @unique
  passwordHash           String
  fullName               String
  role                   Role
  createdAt              DateTime        @default(now())
  dataConsentAt          DateTime?
  dataConsentGiven       Boolean         @default(false)
  emailVerified          Boolean         @default(false)
  emailOtpHash           String?
  emailOtpExpiresAt      DateTime?
  resetTokenHash         String?
  resetTokenExpiresAt    DateTime?
  doctor                 Doctor?
  uploadedMedicalReports MedicalReport[] @relation("MedicalReportUploader")
  patient                Patient?
}

model Patient {
  id                String          @id @default(uuid())
  userId            String          @unique
  gender            String?
  dateOfBirth       DateTime?
  allergies         String[]
  chronicConditions String[]
  age               String?
  bloodGroup        String?
  emergencyContact  String?
  height            String?
  phone             String?
  weight            String?
  appointments      Appointment[]
  ehrRecords        EhrRecord[]
  medicalReports    MedicalReport[]
  user              User            @relation(fields: [userId], references: [id])
  payments          Payment[]
  prescriptions     Prescription[]
}

model Doctor {
  id              String         @id @default(uuid())
  userId          String?        @unique
  specialty       String
  consultationFee Int?
  availableToday  Boolean?
  degrees         String?
  experience      String?
  fee             String?
  hospital        String?
  imageUrl        String?
  location        String?
  name            String?
  priorityLevel   String?
  priorityScore   Int?
  rating          Float?
  reviewsCount    Int?
  tags            String[]
  availability    Json?
  appointments    Appointment[]
  user            User?          @relation(fields: [userId], references: [id])
  prescriptions   Prescription[]
}

model Appointment {
  id                String          @id @default(uuid())
  patientId         String?
  doctorId          String
  scheduledAt       DateTime?
  status            String          @default("WAITING")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  patientName       String?
  patientAge        String?
  patientGender     String?
  patientHeight     String?
  patientWeight     String?
  patientBloodGroup String?
  patientPhone      String?
  patientEmail      String?
  healthConcern     String?
  symptoms          String[]
  duration          String?
  severity          String?
  consultMode       String?
  urgency           String?
  notes             String?
  date              String?
  timeSlot          String?
  priority          String          @default("ROUTINE")
  doctor            Doctor          @relation(fields: [doctorId], references: [id])
  patient           Patient?        @relation(fields: [patientId], references: [id])
  ehrRecord         EhrRecord?
  medicalReports    MedicalReport[]
  payment           Payment?
  prescription      Prescription?
}

model EhrRecord {
  id            String       @id @default(uuid())
  patientId     String
  appointmentId String?      @unique
  diagnosis     String?
  notes         String?
  aiSummary     String?
  createdAt     DateTime     @default(now())
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patient       Patient      @relation(fields: [patientId], references: [id])
}

model Prescription {
  id            String      @id @default(uuid())
  patientId     String
  doctorId      String
  appointmentId String      @unique
  medicines     Json
  dietAdvice    String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  patient       Patient     @relation(fields: [patientId], references: [id])
}

model Payment {
  id              String      @id @default(uuid())
  patientId       String
  appointmentId   String      @unique
  razorpayOrderId String?
  amount          Int
  status          String      @default("PENDING")
  createdAt       DateTime    @default(now())
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  patient         Patient     @relation(fields: [patientId], references: [id])
}

model Hospital {
  id        String @id @default(uuid())
  name      String
  type      String
  latitude  Float
  longitude Float
}

model MedicalReport {
  id                     String                 @id @default(uuid())
  patientId              String
  uploadedByUserId       String
  appointmentId          String?
  originalFileName       String
  storageBucket          String
  storagePath            String                 @unique
  mimeType               String
  fileSizeBytes          BigInt
  reportType             MedicalReportType
  status                 MedicalReportStatus    @default(PENDING_UPLOAD)
  ocrStatus              MedicalReportOcrStatus @default(NOT_STARTED)
  extractedText          String?
  extractedData          Json?
  processingErrorCode    String?
  processingErrorMessage String?
  createdAt              DateTime               @default(now())
  uploadedAt             DateTime?
  processingStartedAt    DateTime?
  processedAt            DateTime?
  updatedAt              DateTime               @updatedAt
  appointment            Appointment?           @relation(fields: [appointmentId], references: [id])
  patient                Patient                @relation(fields: [patientId], references: [id])
  uploadedBy             User                   @relation("MedicalReportUploader", fields: [uploadedByUserId], references: [id])

  @@index([patientId, createdAt])
  @@index([appointmentId])
  @@index([uploadedByUserId])
  @@index([status])
}

enum Role {
  PATIENT
  DOCTOR
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  WAITING
}

enum MedicalReportStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  PROCESSED
  OCR_FAILED
  DELETED
}

enum MedicalReportOcrStatus {
  NOT_STARTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum MedicalReportType {
  LAB_REPORT
  PRESCRIPTION
  DISCHARGE_SUMMARY
  SCAN
  OTHER
}
