generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  fullName         String
  role             Role
  createdAt        DateTime @default(now())
  dataConsentGiven Boolean  @default(false)
  dataConsentAt    DateTime?
}

enum Role {
  PATIENT
  DOCTOR
}