APP_NAME=Sehat-Setu AI Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_TEMPERATURE=0
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
WHISPER_CONTEXT_WORDS=50
MAX_AUDIO_SIZE_MB=25
TRANSCRIPTION_TIMEOUT_SECONDS=120
TEMP_AUDIO_DIR=.tmp/audio
NER_MODEL_NAME=d4data/biomedical-ner-all
# Keep true for offline/local-only startup; set false to allow model download.
NER_LOCAL_FILES_ONLY=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=300
GEMINI_THINKING_BUDGET=0
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
DOCTOR_RULE_CONFIDENCE_THRESHOLD=0.70
DOCTOR_GEMINI_FALLBACK_ENABLED=true
PRESCRIPTION_DUMMY_MODE=false
SUMMARIZE_MAX_TRANSCRIPT_LENGTH=20000
DEFAULT_OUTPUT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,hi-Latn,bn,mr,gu,pa,ta,te,kn,ml,ur
OCR_MAX_FILE_SIZE_MB=10
OCR_MAX_PDF_PAGES=10
OCR_MAX_IMAGE_PIXELS=25000000
GEMINI_OCR_MAX_OUTPUT_TOKENS=4096
FFMPEG_PATH=ffmpeg
INTERNAL_API_KEY=
PORT=8001
AUDIO_CONVERSION_TIMEOUT_SECONDS=30
AUDIO_NORMALIZATION_ENABLED=true
AUDIO_NORMALIZATION_FILTER=highpass=f=80,lowpass=f=8000,loudnorm
VAD_ENABLED=true
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=500
VAD_MIN_RMS=50
LIVE_TRANSCRIPT_DEFAULT_CHUNK_DURATION_MS=10000
LIVE_TRANSCRIPT_MIN_CHUNK_DURATION_MS=1000
LIVE_TRANSCRIPT_OVERLAP_MS=750
LIVE_TRANSCRIPT_SESSION_TTL_SECONDS=900
LIVE_TRANSCRIPT_MAX_ACTIVE_SESSIONS=100
LIVE_TRANSCRIPT_MAX_CHUNK_SIZE_MB=5
LIVE_TRANSCRIPT_MAX_PENDING_CHUNKS=3
