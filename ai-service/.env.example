# Sehat-Setu FastAPI AI service. Copy to ai-service/.env for local use only.
# Never commit real INTERNAL_API_KEY or GEMINI_API_KEY values.

# General
APP_NAME=Sehat-Setu AI Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# Internal authentication and providers. Set strong secrets in production.
INTERNAL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=300
GEMINI_THINKING_BUDGET=0
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_OCR_MAX_OUTPUT_TOKENS=4096
PROVIDER_MAX_CONCURRENT_REQUESTS=2
PROVIDER_REQUEST_TIMEOUT_SECONDS=60

# Whisper
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_CPU_THREADS=0
WHISPER_NUM_WORKERS=1
WHISPER_LANGUAGE_DETECTION_THRESHOLD=0.55
WHISPER_WORD_TIMESTAMPS=true
WHISPER_MEDICAL_PROMPT_ENABLED=true
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_LOG_PROB_THRESHOLD=-1.0
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
WHISPER_TEMPERATURE=0
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
WHISPER_CONTEXT_WORDS=50
WHISPER_SECOND_PASS_ENABLED=true
WHISPER_SECOND_PASS_LOGPROB_THRESHOLD=-0.85
WHISPER_REPETITION_WORD_RUN=6
WHISPER_REPETITION_PHRASE_REPEATS=3
WHISPER_MAX_WORDS_PER_AUDIO_SECOND=5.0
WHISPER_REPEATED_NUMERIC_RUN=6
WHISPER_CORRECTION_CONFIDENCE_THRESHOLD=0.88

# Compatibility names used by deployment profiles. Quality warnings remain
# enabled by design; do not disable them in medical workflows.
ENABLE_SECOND_PASS_TRANSCRIPTION=true
ENABLE_TRANSCRIPTION_QUALITY_WARNINGS=true

# Upload, conversion, and long-audio bounds
MAX_AUDIO_SIZE_MB=25
# AUDIO_MAX_FILE_SIZE_MB=25
AUDIO_MAX_DURATION_SECONDS=3600
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_ENABLE_PREPROCESSING=true
AUDIO_ENABLE_NOISE_REDUCTION=true
AUDIO_ENABLE_SILENCE_TRIMMING=false
AUDIO_MIN_SPEECH_SECONDS=0.35
AUDIO_NORMALIZATION_TARGET=-18.0
AUDIO_CHUNK_DURATION_SECONDS=600
AUDIO_CHUNK_OVERLAP_SECONDS=2
TRANSCRIPTION_TIMEOUT_SECONDS=120
TRANSCRIPTION_MAX_CONCURRENT_REQUESTS=2
TRANSCRIPTION_QUEUE_TIMEOUT_SECONDS=30
TRANSCRIPTION_REQUEST_TIMEOUT_SECONDS=180
MODEL_LOAD_TIMEOUT_SECONDS=300
TEMP_AUDIO_DIR=.tmp/audio
AUDIO_CONVERSION_TIMEOUT_SECONDS=30
AUDIO_NORMALIZATION_ENABLED=true
AUDIO_NORMALIZATION_FILTER=highpass=f=80,lowpass=f=8000,loudnorm
FFMPEG_PATH=ffmpeg
VAD_ENABLED=true
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=500
VAD_MIN_RMS=50

# Long-audio profile aliases. The current implementation uses the matching
# AUDIO_* values above.
LONG_AUDIO_MAX_DURATION_SECONDS=3600
LONG_AUDIO_CHUNK_SECONDS=600
LONG_AUDIO_OVERLAP_SECONDS=2

# OCR. Leave TESSERACT_PATH empty to use PATH discovery locally.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Render/Linux: /usr/bin/tesseract
# TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANGUAGE=eng
OCR_MAX_FILE_SIZE_MB=10
OCR_MAX_PDF_PAGES=10
OCR_MAX_IMAGE_PIXELS=25000000
OCR_MODE=local-first
OCR_LOCAL_ENGINE=tesseract
OCR_PREPROCESS_ENABLED=true
OCR_PREPROCESS_ADAPTIVE_THRESHOLD=true
OCR_PREPROCESS_DESKEW=true
OCR_FALLBACK_THRESHOLD=0.55
OCR_MAX_CONCURRENT_REQUESTS=2
OCR_REQUEST_TIMEOUT_SECONDS=120
OCR_CACHE_TTL_SECONDS=300

# Language, extraction, and clinical generation
NER_MODEL_NAME=d4data/biomedical-ner-all
NER_LOCAL_FILES_ONLY=true
DOCTOR_RULE_CONFIDENCE_THRESHOLD=0.70
DOCTOR_GEMINI_FALLBACK_ENABLED=true
PRESCRIPTION_DUMMY_MODE=false
SUMMARIZE_MAX_TRANSCRIPT_LENGTH=20000
DEFAULT_OUTPUT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,hi-Latn,bn,mr,gu,pa,ta,te,kn,ml,ur

# Live transcription
LIVE_TRANSCRIPT_DEFAULT_CHUNK_DURATION_MS=10000
LIVE_TRANSCRIPT_MIN_CHUNK_DURATION_MS=1000
LIVE_TRANSCRIPT_OVERLAP_MS=750
LIVE_TRANSCRIPT_SESSION_TTL_SECONDS=900
LIVE_TRANSCRIPT_MAX_ACTIVE_SESSIONS=100
LIVE_TRANSCRIPT_MAX_CHUNK_SIZE_MB=5
LIVE_TRANSCRIPT_MAX_PENDING_CHUNKS=3
LIVE_TRANSCRIPTION_MIN_BUFFER_SECONDS=1
LIVE_TRANSCRIPTION_WINDOW_SECONDS=30
LIVE_TRANSCRIPTION_OVERLAP_SECONDS=1
LIVE_TRANSCRIPTION_MAX_BUFFER_MB=25

# Production recommendations:
# APP_ENV=production
# DEBUG=false
# ALLOWED_ORIGINS=https://your-frontend.example
# INTERNAL_API_KEY=<strong-random-server-side-secret>
# FFMPEG_PATH=/usr/bin/ffmpeg
# TESSERACT_PATH=/usr/bin/tesseract
