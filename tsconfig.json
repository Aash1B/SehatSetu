    "target": "ES2021",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "exclude": [
    "authentication-system",
    "frontend",
    "node_modules",
    "dist",
    "vite.config.ts",
    "eslint.config.js"
